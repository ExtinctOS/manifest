<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Build -->
  <remove-project name="LineageOS/android_build" />
  <project path="make" name="android_build" remote="extinct" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <remove-project name="LineageOS/android_build_soong" />
  <project path="build/soong" name="android_build_soong" remote="extinct" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- Core -->
  <remove-project name="LineageOS/android_bionic" />
  <project path="bionic" name="android_bionic" remote="extinct" />

  <!-- Bootable -->
  <remove-project name="LineageOS/android_bootable_deprecated-ota" />
  <project path="bootable/deprecated-ota" name="android_bootable_deprecated-ota" remote="extinct" />
  <remove-project name="LineageOS/android_bootable_recovery" />
  <project path="bootable/recovery" name="android_bootable_recovery" remote="extinct" />

  <remove-project name="LineageOS/android_device_lineage_sepolicy" />
  <project path="device/extinct/sepolicy" name="android_device_extinct_sepolicy" remote="extinct"/>

  <!-- External -->
  <remove-project name="platform/external/bouncycastle" />
  <project path="external/bouncycastle" name="android_external_bouncycastle" remote="neoteric" />

  <!-- Frameworks -->
  <remove-project name="LineageOS/android_frameworks_av" />
  <project path="frameworks/av" name="android_frameworks_av" remote="extinct" />
  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="extinct" />
  <remove-project name="LineageOS/android_frameworks_libs_systemui" />
  <project path="frameworks/libs/systemui" name="android_frameworks_libs_systemui" remote="extinct" />

  <!-- Hardware (Extinct) -->
  <remove-project name="LineageOS/android_hardware_lineage_interfaces" />
  <project path="hardware/extinct/interfaces" name="android_hardware_extinct_interfaces" remote="extinct" />

  <!-- Packages -->
  <remove-project name="LineageOS/android_packages_apps_Settings" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="extinct" />
  <remove-project name="LineageOS/android_packages_apps_Launcher3"/>
  <project path="packages/apps/Launcher3" name="android_packages_apps_Launcher3" remote="neoteric" />
  <remove-project name="LineageOS/android_packages_apps_ThemePicker"/>
  <project path="packages/appsThemePicker" name="android_packages_apps_ThemePicker" remote="neoteric" />
  <project path="packages/apps/NeotericWallpaperStub" name="android_packages_apps_NeotericWallpaperStub" remote="neoteric"/>
  <remove-project name="LineageOS/android_packages_apps_WallpaperPicker2"/>
  <project path="packages/apps/WallpaperPicker2" name="android_packages_apps_WallpaperPicker2" remote="neoteric" />
  <project path="packages/apps/Updates" name="android_packages_apps_Updates" remote="extinct" />
  <project path="packages/services/SmartSpace" name="android_packages_services_SmartSpace" remote="neoteric" />
  <project path="packages/apps/TouchGestures" name="android_packages_apps_TouchGestures" remote="neoteric" />
  <project path="packages/apps/GameSpace" name="android_packages_apps_GameSpace" remote="neoteric" />
  <project path="packages/apps/ParanoidSense" name="android_packages_apps_ParanoidSense" remote="neoteric" />
  <project path="packages/apps/aptxacu" name="android_packages_apps_aptxacu" remote="neoteric" />

  <!-- System -->
  <remove-project name="LineageOS/android_system_core" />
  <project path="system/core" name="android_system_core" remote="extinct" />
  <remove-project name="LineageOS/android_system_sepolicy" />
  <project path="system/sepolicy" name="android_system_sepolicy" remote="extinct" />

  <!-- Vendor (Neoteric) -->
  <remove-project name="LineageOS/android_vendor_lineage" />
  <project path="vendor/extinct" name="android_vendor_extinct" remote="extinct" />
  <project path="vendor/extinct_prebuilt" name="android_vendor_extinct_prebuilt" remote="extinct" />
  <project path="vendor/gms" name="android_vendor_gms" remote="neoteric-gitea" clone-depth="1" />
  <project path="vendor/themes" name="android_vendor_themes" remote="neoteric" />
  <project path="vendor/preferences" name="android_vendor_preferences" remote="neoteric" />
  <project path="vendor/gms_spoof" name="android_vendor_gms_spoof" remote="neoteric" revision="master" />

  <!-- OTA -->
  <project path="ota" name="OTA" remote="extinct" />
</manifest>
